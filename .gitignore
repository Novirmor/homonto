/opencode.json

# E2E matrix run logs (scratch)
test/e2e/.out/

# External workflow-stack scaffolding (Comet + OpenSpec + Superpowers),
# retired for this repo by ADR 0023. Kept ignored so stale local scaffolding
# from before the retirement can never be committed. The durable record of a
# decision is an ADR in docs/adr/.
/.comet/
/.superpowers/
/openspec/
/docs/superpowers/

# OKF grounding bundle — generated from the code, regenerated on demand.
/okf_bundle/
