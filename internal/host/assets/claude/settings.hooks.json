{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "BINARY host probe --json --host claude"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Write|Edit|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "BINARY host guard --host claude"
        }
      ]
    }
  ]
}
