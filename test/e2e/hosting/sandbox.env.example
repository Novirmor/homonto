# Sandbox fixtures for scripts/hosting-sandbox.sh. Copy to sandbox.env (gitignored)
# and fill in the hosts you have sandboxes for; a host without HOSTING_<H>_REPO_URL
# is skipped. Every repository must be a throwaway sandbox: the runtime check
# posts and deletes a comment, and HOSTING_WRITE=1 pushes and force-resets
# the fixture branches.
#
# Fixtures per host: one open issue (GitHub, GitLab), one open PR/MR from a
# FORK with at least one unresolved review thread (its head is pinned below),
# and one open PR/MR whose head conflicts with its base (pinned head below).

# --- GitHub (credentials: GH_TOKEN) -----------------------------------------
HOSTING_GH_REPO_URL=https://github.com/OWNER/homonto-sandbox.git
HOSTING_GH_WEB_URL=https://github.com/OWNER/homonto-sandbox
HOSTING_GH_ISSUE_URL=https://github.com/OWNER/homonto-sandbox/issues/1
HOSTING_GH_PR_URL=https://github.com/OWNER/homonto-sandbox/pull/2
HOSTING_GH_PR_BRANCH=fixture/feedback
HOSTING_GH_PR_HEAD=0000000000000000000000000000000000000000
HOSTING_GH_CONFLICT_PR_URL=https://github.com/OWNER/homonto-sandbox/pull/3
HOSTING_GH_CONFLICT_BRANCH=fixture/conflict
HOSTING_GH_CONFLICT_HEAD=0000000000000000000000000000000000000000

# --- GitLab.com (credentials: GITLAB_TOKEN) ---------------------------------
HOSTING_GL_REPO_URL=https://gitlab.com/GROUP/homonto-sandbox.git
HOSTING_GL_WEB_URL=https://gitlab.com/GROUP/homonto-sandbox
HOSTING_GL_ISSUE_URL=https://gitlab.com/GROUP/homonto-sandbox/-/issues/1
HOSTING_GL_PR_URL=https://gitlab.com/GROUP/homonto-sandbox/-/merge_requests/1
HOSTING_GL_PR_BRANCH=fixture/feedback
HOSTING_GL_PR_HEAD=0000000000000000000000000000000000000000
HOSTING_GL_CONFLICT_PR_URL=https://gitlab.com/GROUP/homonto-sandbox/-/merge_requests/2
HOSTING_GL_CONFLICT_BRANCH=fixture/conflict
HOSTING_GL_CONFLICT_HEAD=0000000000000000000000000000000000000000

# --- Bitbucket Cloud (credentials: HOMONTO_BITBUCKET_TOKEN, optional HOMONTO_BITBUCKET_EMAIL)
HOSTING_BB_REPO_URL=https://bitbucket.org/WORKSPACE/homonto-sandbox.git
HOSTING_BB_WEB_URL=https://bitbucket.org/WORKSPACE/homonto-sandbox
HOSTING_BB_PR_URL=https://bitbucket.org/WORKSPACE/homonto-sandbox/pull-requests/1
HOSTING_BB_PR_BRANCH=fixture/feedback
HOSTING_BB_PR_HEAD=0000000000000000000000000000000000000000
HOSTING_BB_CONFLICT_PR_URL=https://bitbucket.org/WORKSPACE/homonto-sandbox/pull-requests/2
HOSTING_BB_CONFLICT_BRANCH=fixture/conflict
HOSTING_BB_CONFLICT_HEAD=0000000000000000000000000000000000000000
HOSTING_BB_BRIEF=Add a CONTRIBUTING.md that explains how to run the tests.
