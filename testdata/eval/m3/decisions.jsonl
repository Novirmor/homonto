// Labelled questions for `m3eval decisions`: classification, next-step selection, yes-no and score.
{"id":"triage-bug","request":{"point":"eval.classify","kind":"choice","question":"Which triage process fits this tracker issue? bug: something that worked is broken. feature: a request for new behavior. question: the reporter needs an answer, not a change.","options":["bug","feature","question"],"context":{"issue":"Since yesterday's release the checkout page shows a blank screen after payment. It worked last week."}},"expect":"bug"}
{"id":"triage-feature","request":{"point":"eval.classify","kind":"choice","question":"Which triage process fits this tracker issue? bug: something that worked is broken. feature: a request for new behavior. question: the reporter needs an answer, not a change.","options":["bug","feature","question"],"context":{"issue":"It would be great if invoices could be exported as CSV in addition to PDF."}},"expect":"feature"}
{"id":"triage-question","request":{"point":"eval.classify","kind":"choice","question":"Which triage process fits this tracker issue? bug: something that worked is broken. feature: a request for new behavior. question: the reporter needs an answer, not a change.","options":["bug","feature","question"],"context":{"issue":"How do I change the email address on my account? I could not find the setting."}},"expect":"question"}
{"id":"triage-bug-terse","request":{"point":"eval.classify","kind":"choice","question":"Which triage process fits this tracker issue? bug: something that worked is broken. feature: a request for new behavior. question: the reporter needs an answer, not a change.","options":["bug","feature","question"],"context":{"issue":"500 on /api/orders when the cart has more than 99 items."}},"expect":"bug"}
{"id":"next-repair","request":{"point":"eval.next-step","kind":"choice","question":"The candidate was reviewed. Should the engine repair the change, re-run verification, or deliver it?","options":["repair","verify","deliver"],"context":{"review":"2 major findings: the migration drops a column still read by the reporting job; the new endpoint lacks an authorization check."}},"expect":"repair"}
{"id":"next-deliver","request":{"point":"eval.next-step","kind":"choice","question":"The candidate was reviewed. Should the engine repair the change, re-run verification, or deliver it?","options":["repair","verify","deliver"],"context":{"review":"No findings. All 214 tests pass, lint is clean, and the change matches the design."}},"expect":"deliver"}
{"id":"next-verify","request":{"point":"eval.next-step","kind":"choice","question":"The candidate was reviewed. Should the engine repair the change, re-run verification, or deliver it?","options":["repair","verify","deliver"],"context":{"review":"No findings in the diff, but the test run was interrupted by a CI timeout and never finished."}},"expect":"verify"}
{"id":"needs-design-yes","request":{"point":"eval.needs-design","kind":"yes-no","question":"Does this change need a written design before implementation?","context":{"issue":"Replace the session store with a distributed cache shared by all regions, keeping existing sessions valid."}},"expect":"yes"}
{"id":"needs-design-no","request":{"point":"eval.needs-design","kind":"yes-no","question":"Does this change need a written design before implementation?","context":{"issue":"Fix the typo 'recieve' in the signup confirmation email."}},"expect":"no"}
{"id":"secret-in-diff","request":{"point":"eval.secret","kind":"yes-no","question":"Does this diff add a credential or secret to the repository?","context":{"diff":"+AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\n+region=eu-west-1"}},"expect":"yes"}
{"id":"urgency-high","request":{"point":"eval.urgency","kind":"score","question":"How urgent is this issue?","scale":{"min":0,"max":10},"levels":["can wait","normal","urgent"],"context":{"issue":"Production is down for all customers in the EU region since 09:12."}},"expect":[7,10]}
{"id":"urgency-low","request":{"point":"eval.urgency","kind":"score","question":"How urgent is this issue?","scale":{"min":0,"max":10},"levels":["can wait","normal","urgent"],"context":{"issue":"The footer links use a slightly different shade of grey than the header."}},"expect":[0,3.5]}
